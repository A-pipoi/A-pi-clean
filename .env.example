# Fresh development configuration only. Do not copy production credentials.
A_PI_DATA_ROOT=./development-data
A_PI_PAPER_AUTO=0
A_PI_DEEP_AUTO=0
# Optional absolute path to an independent Python 3.12. Empty uses deep_factor/.venv.
A_PI_DEEP_PYTHON=
TUSHARE_TOKEN=
# Optional trusted HTTPS extension endpoint. No userinfo/query/fragment or redirects.
# A_PI_TUSHARE_API_URL=https://api.tushare.pro
A_PI_TUSHARE_HOURLY_LIMIT=5000
A_PI_TUSHARE_DAILY_LIMIT=10000
A_PI_TLS_CERT=
A_PI_TLS_KEY=
